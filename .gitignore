# --- Node / TypeScript build output ---
node_modules/
dist/
build/
out/
*.tsbuildinfo
.turbo/

# --- Test / coverage ---
coverage/
.nyc_output/
.vitest-cache/

# --- Logs / temp ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/settings.json.example

# --- Environment ---
.env
.env.*
!.env.example

# --- OCN runtime artifacts (project-managed, not source) ---
# Generated by `ocn init`; users may commit selectively but they are not source code.
# When dogfooding OCN with OCN itself, commit on purpose, not by default.
.ocoding/.lock
.ocoding/state.json.bak
.ocoding/state.json.*.tmp
.ocoding/audit/*.jsonl

# --- Claude Code local-only settings (commit shared rules, not personal) ---
.claude/settings.local.json
.claude/cache/

# --- Misc ---
*.swp
*.swo
.history/
