{
  "name": "o-coding-navigation",
  "version": "0.5.0-beta.3",
  "description": "Local-first AI coding navigation CLI and MCP server with step gates, audit trail, and SOP-aware project state.",
  "type": "module",
  "bin": {
    "ocn": "dist/cli/index.js",
    "ocn-mcp": "dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs/quickstart.md",
    "docs/mcp-usage.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js dist/mcp/index.js",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UncleTIM-GZ/O-CodingNavigation.git"
  },
  "bugs": {
    "url": "https://github.com/UncleTIM-GZ/O-CodingNavigation/issues"
  },
  "homepage": "https://github.com/UncleTIM-GZ/O-CodingNavigation#readme",
  "keywords": [
    "ai-coding",
    "mcp",
    "cli",
    "sop",
    "project-management",
    "developer-tools",
    "audit-trail"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.7.0",
    "vitest": "^2.1.1"
  }
}
